#!/bin/sh
set -eu

script_dir=$(/usr/bin/dirname "$0")
case "$script_dir" in /*) ;; *) exit 1 ;; esac

/usr/bin/codesign --verify --strict --verbose=2 "$script_dir/pkg-install"

# A background launchd job loses the interactive user's TCC authorization.
# Keep the real exit status: PackageKit must not report success before setup.
if /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=/var/root \
    PKG_INSTALL_DEBUG=1 "$script_dir/pkg-install"; then
    exit 0
else
    code=$?
    echo "pkg setup failed (exit $code). See /var/log/install.log." >&2
    echo "If macOS denied system configuration access, use install-preview.sh from a terminal." >&2
    exit "$code"
fi
