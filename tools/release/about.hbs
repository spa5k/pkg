<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>pkg third-party licenses</title>
</head>
<body>
  <h1>Third-Party Licenses</h1>
  <p>This file lists the Rust packages included in pkg.</p>
  {{#each licenses}}
    {{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
    <h3>{{name}}</h3>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}<li data-crate="{{crate.name}}" data-version="{{crate.version}}">{{crate.name}} {{crate.version}}</li>{{/each}}
    </ul>
    <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
